    <string name="privacy_title">Privacy Policy</string>
    <string name="privacy_permissions_title">App Permissions</string>
    <string name="privacy_permissions_content">Image conversion needs no system permissions and works without networking.\n\nPermissions are used only for:\n• Network: querying the release page when checking for updates\n• Notifications: showing update download progress\n• Install unknown apps: guided by the system installer when installing an update\n\nDeclining these permissions does not affect image conversion.</string>
    <string name="privacy_data_collection_title">Data Collection</string>
    <string name="privacy_data_collection_content">This app does not collect any personal information.\n\nOnly the following local settings are stored:\n• Theme preference\n• Language preference\n• Output directory setting\n\nAll data is stored locally on your device only and will not be uploaded to any server.</string>
    <string name="privacy_network_title">Network Connection</string>
    <string name="privacy_network_content">Image conversion runs fully offline and all image processing happens on your device.\n\nThe network is used only when you check for updates or download an update package, which queries the GitHub release page. No images or personal data are ever uploaded.</string>
